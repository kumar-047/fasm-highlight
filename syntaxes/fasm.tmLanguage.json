          "match": "(?i)(?<![\\w.@$?])(?:k0|k1|k2|k3|k4|k5|k6|k7)(?![\\w.@$?])"
        },
        {
          "name": "variable.language.register.bounds.fasm",
          "match": "(?i)(?<![\\w.@$?])(?:bnd0|bnd1|bnd2|bnd3)(?![\\w.@$?])"
        },
        {
          "name": "variable.language.register.amx.fasm",
          "match": "(?i)(?<![\\w.@$?])(?:tmm0|tmm1|tmm2|tmm3|tmm4|tmm5|tmm6|tmm7)(?![\\w.@$?])"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.fasm",
          "match": "(?<![\\w.@$?])(?:0[xX][0-9a-fA-F_']+|[0-9][0-9a-fA-F_']*[hH]|\\$[0-9a-fA-F][0-9a-fA-F_']*)(?![\\w.@$?])"
        },
        {
          "name": "constant.numeric.float.fasm",
          "match": "(?<![\\w.@$?])(?:\\d+\\.\\d+(?:[eE][+-]?\\d+)?|\\d+[eE][+-]?\\d+|\\d+[fF])(?![\\w.@$?])"
        },
        {
          "name": "constant.numeric.binary.fasm",
          "match": "(?<![\\w.@$?])(?:0[bB][01_']+|[01][01_']*[bB])(?![\\w.@$?])"
        },
        {
          "name": "constant.numeric.octal.fasm",
          "match": "(?<![\\w.@$?])(?:0[oO][0-7_']+|[0-7][0-7_']*[oOqQ])(?![\\w.@$?])"
        },
        {
          "name": "constant.numeric.decimal.fasm",
          "match": "(?<![\\w.@$?])[0-9][0-9_']*[dD]?(?![\\w.@$?])"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "constant.character.escape.line-continuation.fasm",
          "match": "\\\\(?=\\s*(?:;|$))"
        },
        {
          "name": "keyword.operator.special.fasm",
          "match": "\\$%%|\\$%|\\$@|\\$\\$|\\$|%%|%t\\b|%|#|`"
        },
        {
          "name": "keyword.operator.comparison.fasm",
          "match": "<=|>=|<>|<|>"
        },
        {
          "name": "keyword.operator.assignment.fasm",
          "match": ":=|=:|="
        },
        {
          "name": "keyword.operator.logical.fasm",
          "match": "&|\\||~"
        },
        {
          "name": "keyword.operator.word.fasm",
          "match": "(?i)(?<![\\w.@$?])(?:and|as|at|bappend|defined|definite|dup|elementof|elementsof|eq|eqtype|far|from|lengthof|metadataof|mod|near|not|on|or|plt|ptr|relativeto|rva|scaleof|shl|short|shr|used|xor)(?![\\w.@$?])"
        },
        {
          "name": "keyword.operator.arithmetic.fasm",
          "match": "\\+|-|\\*|/"
        }
      ]
    },
    "data": {
      "patterns": [
        {
          "name": "storage.type.data.fasm",
          "match": "(?i)(?<![\\w.@$?])(?:db|dbx|dd|ddq|ddqq|df|dp|dq|dqq|dt|du|dw|emit|file)(?![\\w.@$?])"
        },
        {
          "name": "storage.type.data.fasm",
          "match": "(?i)(?<![\\w.@$?])(?:rb|rd|rdq|rdqq|rf|rp|rq|rqq|rt|rw)(?![\\w.@$?])"
        },
        {
          "name": "storage.type.size.fasm",
          "match": "(?i)(?<![\\w.@$?])(?:byte|dqqword|dqword|dword|fword|pword|qqword|qword|tbyte|tword|word|xword|yword|zword)(?![\\w.@$?])"
        }
      ]
    }
  }
}
