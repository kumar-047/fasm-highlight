{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "FASM",
  "scopeName": "source.fasm",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#format-lines"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#labels"
    },
    {
      "include": "#calm-blocks"
    },
    {
      "include": "#definitions"
    },
    {
      "include": "#statement-words"
    },
    {
      "include": "#directives"
    },
    {
      "include": "#macro-helpers"
    },
    {
      "include": "#instructions"
    },
    {
      "include": "#decorators"
    },
    {
      "include": "#registers"
    },
    {
      "include": "#language-constants"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#data"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.semicolon.fasm",
          "match": ";.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.fasm",
          "begin": "\"",
          "end": "\"|$"
        },
        {
          "name": "string.quoted.single.fasm",
          "begin": "'",
          "end": "'|$"
        }
      ]
    },
    "format-lines": {
      "patterns": [
        {
          "begin": "(?i)(?:^\\s*|(?<=[:{])\\s*)(format)(?![\\w.@$?])(?!\\s*[:=]|\\s+(?:d[bwdqtpfu]|r[bwdqtpf]|equ|fix|label)\\b)",
          "end": "$",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.directive.format.fasm"
            }
          },
          "patterns": [
            {
              "include": "#comments"
            },
            {
              "include": "#strings"
            },
            {
              "include": "#format-keywords"
            },
            {
              "include": "#numbers"
            },
            {
              "include": "#operators"
            }
          ]
        },
        {
          "begin": "(?i)(?:^\\s*|(?<=[:{])\\s*)(section|segment)(?![\\w.@$?])(?!\\s*[:=]|\\s+(?:d[bwdqtpfu]|r[bwdqtpf]|equ|fix|label)\\b)",
          "end": "$",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.directive.section.fasm"
            }
          },
          "patterns": [
            {
              "include": "#comments"
            },
            {
              "name": "entity.name.section.fasm",
              "match": "'[^']*'"
            },
            {
              "include": "#strings"
            },
            {
              "include": "#format-keywords"
            },
            {
              "include": "#numbers"
            },
            {
              "include": "#operators"
            }
          ]
        },
        {
          "begin": "(?i)(?:^\\s*|(?<=[:{])\\s*)(data)(?![\\w.@$?])(?!\\s*[:=]|\\s+(?:d[bwdqtpfu]|r[bwdqtpf]|equ|fix|label)\\b)",
          "end": "$",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.directive.statement.fasm"
            }
          },
          "patterns": [
            {
              "include": "#comments"
            },
            {
              "include": "#strings"
            },
            {
              "include": "#format-keywords"
            },
            {
              "include": "#numbers"
            },
            {
              "include": "#operators"
            }
          ]
        }
      ]
    },
    "format-keywords": {
      "patterns": [
        {
          "name": "keyword.other.format.fasm",
          "match": "(?i)(?<![\\w.@$?])(?:binary|code|coff|console|data|discardable|dll|dynamic|efi|efiboot|efiruntime|elf|elf64|executable|export|fixups|gnuehframe|gnurelro|gnustack|gui|import|interpreter|large|linkinfo|linkremove|macho|macho64|ms|ms64|mz|native|note|notpageable|nx|pe|pe64|readable|resource|shareable|static|wdm|writable|writeable)(?![\\w.@$?])"
        }
      ]
    },
    "labels": {
      "patterns": [
        {
          "name": "entity.name.label.anonymous.fasm",
          "match": "^\\s*@@:"
        },
        {
          "name": "entity.name.label.local.fasm",
          "match": "^\\s*\\.[A-Za-z_?][\\w.?$@]*:"
        },
        {
          "name": "entity.name.label.fasm",
          "match": "^\\s*[A-Za-z_?][\\w.?$@]*:"
        },
        {
          "name": "keyword.control.label-reference.fasm",
          "match": "(?i)(?<![\\w@.])@[bfr]\\b"
        }
      ]
    },
    "calm-blocks": {
      "patterns": [
        {
          "begin": "(?i)(?:^\\s*|(?<=[:{])\\s*)(calminstruction)\\s+(?:\\([^)]*\\)\\s*)?([A-Za-z_.?][\\w.?!$@]*)",
          "end": "(?i)^\\s*(end)\\s+(calminstruction)\\b",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.directive.macro.fasm"
            },
            "2": {
              "name": "entity.name.function.fasm"
            }
          },
          "endCaptures": {
            "1": {
              "name": "keyword.control.directive.macro.fasm"
            },
            "2": {
              "name": "keyword.control.directive.macro.fasm"
            }
          },
          "patterns": [
            {
              "match": "(?i)(?:^\\s*|(?<=[:{])\\s*)(arrange|assemble|call|check|compute|exit|jno|jump|jyes|local|match|publish|rawmatch|rmatch|stringify|take|taketext|transform)(?![\\w.@$?])",
              "captures": {
                "1": {
                  "name": "keyword.control.directive.calm.fasm"
                }
              }
            },
            {
              "include": "$self"
            }
          ]
        }
      ]
    },
    "definitions": {
      "patterns": [
        {
          "match": "(?i)(?:^\\s*|(?<=[:{])\\s*)(macro|struc)\\s+(?:\\([^)]*\\)\\s*)?([A-Za-z_.?][\\w.?!$@]*)",
          "captures": {
            "1": {
              "name": "keyword.control.directive.macro.fasm"
            },
            "2": {
              "name": "entity.name.function.fasm"
            }
          }
        },
        {
          "match": "(?i)(?:^\\s*|(?<=[:{])\\s*)(namespace)\\s+(?:\\([^)]*\\)\\s*)?([A-Za-z_.?][\\w.?!$@]*)",
          "captures": {
            "1": {
              "name": "keyword.control.directive.fasmg.fasm"
            },
            "2": {
              "name": "entity.name.namespace.fasm"
            }
          }
        },
        {
          "match": "(?i)(?:^\\s*|(?<=[:{])\\s*)(label)\\s+(?:\\([^)]*\\)\\s*)?([A-Za-z_.?][\\w.?!$@]*)",
          "captures": {
            "1": {
              "name": "keyword.control.directive.other.fasm"
            },
            "2": {
              "name": "entity.name.label.fasm"
            }
          }
        }
      ]
    },
    "decorators": {
      "patterns": [
        {
          "name": "storage.modifier.fasm",
          "match": "(?i)(?<=\\{)(?:1to(?:2|4|8|16|32)|z|sae|(?:rn|rd|ru|rz)-sae)(?=\\})"
        }
      ]
    },
    "language-constants": {
      "patterns": [
        {
          "name": "constant.language.fasm",
          "match": "(?i)(?<![\\w.@$?])(?:__file__|__line__|__source__|__time__)(?![\\w.@$?])"
        },
        {
          "name": "constant.language.fasm",
          "match": "(?<=[\\s,(])\\?(?=\\s*(?:[,;)]|$))"
        }
      ]
    },
    "statement-words": {
      "patterns": [
        {
          "match": "(?i)(?:^\\s*|(?<=[:{])\\s*)(end)\\s+(data|iterate|irpv|namespace|rawmatch|rmatch|postpone)(?![\\w.@$?])",
          "captures": {
            "1": {
              "name": "keyword.control.directive.statement.fasm"
            },
            "2": {
              "name": "keyword.control.directive.statement.fasm"
            }
          }
        },
        {
          "match": "(?i)(?:^\\s*|(?<=[:{])\\s*)(end|heap|stack)(?![\\w.@$?])(?!\\s*[:=]|\\s+(?:d[bwdqtpfu]|r[bwdqtpf]|equ|fix|label)\\b)",
          "captures": {
            "1": {
              "name": "keyword.control.directive.statement.fasm"
            }
          }
        },
        {
          "match": "(?i)(?:^\\s*|(?<=[:{])\\s*)(combinelines|element|esc|eval|indx|isolatelines|iterate|mvmacro|mvstruc|namespace|outscope|rawmatch|removecomments|restartout|retaincomments|rmatch|use)(?![\\w.@$?])(?!\\s*[:=]|\\s+(?:d[bwdqtpfu]|r[bwdqtpf]|equ|fix|label)\\b)",
          "captures": {
            "1": {
              "name": "keyword.control.directive.fasmg.fasm"
            }
          }
        },
        {
          "match": "(?i)(?:^\\s*|(?<=[:{])\\s*)(and|not|or|shl|shr|xor)(?![\\w.@$?])",
          "captures": {
            "1": {
              "name": "keyword.other.mnemonic.logical.fasm"
            }
          }
        },
        {
          "match": "(?i)(?<![\\w.@$?])(lock)\\s+(and|not|or|shl|shr|xor)(?![\\w.@$?])",
          "captures": {
            "1": {
              "name": "keyword.other.mnemonic.misc.fasm"
            },
            "2": {
              "name": "keyword.other.mnemonic.logical.fasm"
            }
          }
        }
      ]
    },
    "directives": {
      "patterns": [
        {
          "name": "keyword.control.directive.structure.fasm",
          "match": "(?i)(?<![\\w.@$?])(?:restruc|struc)(?![\\w.@$?])"
        },
        {
          "name": "keyword.control.directive.macro.fasm",
          "match": "(?i)(?<![\\w.@$?])(?:common|forward|irp|irps|irpv|local|macro|match|postpone|purge|rept|reverse)(?![\\w.@$?])"
        },
        {
          "name": "keyword.control.directive.include.fasm",
          "match": "(?i)(?<![\\w.@$?])(?:include)(?![\\w.@$?])"
        },
        {
          "name": "keyword.control.directive.constant.fasm",
          "match": "(?i)(?<![\\w.@$?])(?:define|equ|fix|redefine|reequ|restore)(?![\\w.@$?])"
        },
        {
          "name": "keyword.control.directive.entry.fasm",
          "match": "(?i)(?<![\\w.@$?])(?:entry)(?![\\w.@$?])"
        },
        {
          "name": "keyword.control.directive.addressing.fasm",
          "match": "(?i)(?<![\\w.@$?])(?:use16|use32|use64|useavx256|useavx512)(?![\\w.@$?])"
        },
        {
          "name": "keyword.control.directive.conditional.fasm",
          "match": "(?i)(?<![\\w.@$?])(?:else|if)(?![\\w.@$?])"
        },
        {
          "name": "keyword.control.directive.repeat.fasm",
          "match": "(?i)(?<![\\w.@$?])(?:break|repeat|times|while)(?![\\w.@$?])"
        },
        {
          "name": "keyword.control.directive.linkage.fasm",
          "match": "(?i)(?<![\\w.@$?])(?:export|extrn|import|public)(?![\\w.@$?])"
        },
        {
          "name": "keyword.control.directive.other.fasm",
          "match": "(?i)(?<![\\w.@$?])(?:align|assert|display|err|label|load|org|store|virtual)(?![\\w.@$?])"
        }
      ]
    },
    "macro-helpers": {
      "patterns": [
        {
          "name": "support.function.macro-helper.fasm",
          "match": "(?i)(?<![\\w.@$?])(?:api|ccall|cinvoke|comcall|cominvk|endp|ends|fastcall|interface|invoke|library|proc|sizeof|stdcall|struct|union)(?![\\w.@$?])"
        }
      ]
    },
    "instructions": {
      "patterns": [
        {
          "name": "keyword.other.mnemonic.data-movement.fasm",
          "match": "(?i)(?<![\\w.@$?])(?:cbw|cdq|cdqe|cqo|cwd|cwde|in|lds|lea|les|lfs|lgs|lss|mov|movnti|movsx|movsxd|movzx|out|pop|popa|popad|popaw|popd|popq|popw|push|pusha|pushad|pushaw|pushd|pushq|pushw|xchg|xlat|xlatb)(?![\\w.@$?])"
        },
        {
          "name": "keyword.other.mnemonic.arithmetic.fasm",
          "match": "(?i)(?<![\\w.@$?])(?:aaa|aad|aam|aas|adc|add|cmp|cmpxchg|cmpxchg16b|cmpxchg8b|daa|das|dec|div|idiv|imul|inc|mul|neg|salc|sbb|sub|xadd)(?![\\w.@$?])"
        },
        {
          "name": "keyword.other.mnemonic.logical.fasm",
          "match": "(?i)(?<![\\w.@$?])(?:bsf|bsr|bswap|bt|btc|btr|bts|rcl|rcr|rol|ror|sal|sar|shld|shrd|test)(?![\\w.@$?])"
        },
        {
          "name": "keyword.other.mnemonic.control-flow.fasm",
          "match": "(?i)(?<![\\w.@$?])(?:bound|call|enter|int|int1|int3|into|iret|iretd|iretq|iretw|ja|jae|jb|jbe|jc|jcxz|je|jecxz|jg|jge|jl|jle|jmp|jna|jnae|jnb|jnbe|jnc|jne|jng|jnge|jnl|jnle|jno|jnp|jns|jnz|jo|jp|jpe|jpo|jrcxz|js|jz|leave|loop|loopd|loope|looped|loopeq|loopew|loopne|loopned|loopneq|loopnew|loopnz|loopnzd|loopnzq|loopnzw|loopq|loopw|loopz|loopzd|loopzq|loopzw|ret|retd|retf|retfd|retfq|retfw|retn|retnd|retnq|retnw|retq|retw)(?![\\w.@$?])"
        },
        {
          "name": "keyword.other.mnemonic.string.fasm",
          "match": "(?i)(?<![\\w.@$?])(?:cmps|cmpsb|cmpsd|cmpsq|cmpsw|ins|insb|insd|insw|lods|lodsb|lodsd|lodsq|lodsw|movs|movsb|movsd|movsq|movsw|outs|outsb|outsd|outsw|rep|repe|repne|repnz|repz|scas|scasb|scasd|scasq|scasw|stos|stosb|stosd|stosq|stosw)(?![\\w.@$?])"
        },
        {
          "name": "keyword.other.mnemonic.flag.fasm",
          "match": "(?i)(?<![\\w.@$?])(?:clc|cld|cli|cmc|lahf|popf|popfd|popfq|popfw|pushf|pushfd|pushfq|pushfw|sahf|stc|std|sti)(?![\\w.@$?])"
        },
        {
          "name": "keyword.other.mnemonic.conditional.fasm",
          "match": "(?i)(?<![\\w.@$?])(?:cmova|cmovae|cmovb|cmovbe|cmovc|cmove|cmovg|cmovge|cmovl|cmovle|cmovna|cmovnae|cmovnb|cmovnbe|cmovnc|cmovne|cmovng|cmovnge|cmovnl|cmovnle|cmovno|cmovnp|cmovns|cmovnz|cmovo|cmovp|cmovpe|cmovpo|cmovs|cmovz|seta|setae|setalc|setb|setbe|setc|sete|setg|setge|setl|setle|setna|setnae|setnb|setnbe|setnc|setne|setng|setnge|setnl|setnle|setno|setnp|setns|setnz|seto|setp|setpe|setpo|sets|setz)(?![\\w.@$?])"
        },
        {
          "name": "keyword.other.mnemonic.misc.fasm",
          "match": "(?i)(?<![\\w.@$?])(?:bnd|cpuid|fxrstor|fxrstor64|fxsave|fxsave64|lock|nop|pause|ud0|ud1|ud2|wait)(?![\\w.@$?])"
        },
        {
          "name": "keyword.other.mnemonic.system.fasm",
          "match": "(?i)(?<![\\w.@$?])(?:arpl|clac|clgi|clts|hlt|icebp|invd|invlpg|invlpga|invlpgb|lar|lgdt|lidt|lldt|lmsw|loadall286|loadall386|lsl|ltr|mcommit|monitor|monitorx|mwait|mwaitx|pcommit|psmash|pvalidate|rdmsr|rdmsrq|rdpmc|rdpru|rdtsc|rdtscp|rmpadjust|rmpupdate|rsm|sgdt|sidt|skinit|sldt|smsw|stac|stgi|str|swapgs|syscall|sysenter|sysexit|sysexitq|sysret|sysretq|tlbsync|vmcall|vmclear|vmfunc|vmlaunch|vmload|vmmcall|vmptrld|vmptrst|vmread|vmresume|vmrun|vmsave|vmwrite|vmxoff|vmxon|wbinvd|wrmsr|wrmsrq|xrstors|xrstors64|xsaves|xsaves64)(?![\\w.@$?])"
        },
        {
          "name": "keyword.other.mnemonic.fpu.fasm",
          "match": "(?i)(?<![\\w.@$?])(?:f2xm1|fabs|fadd|faddp|fbld|fbstp|fchs|fclex|fcmovb|fcmovbe|fcmove|fcmovnb|fcmovnbe|fcmovne|fcmovnu|fcmovu|fcom|fcomi|fcomip|fcomp|fcompp|fcos|fdecstp|fdisi|fdiv|fdivp|fdivr|fdivrp|feni|ffree|ffreep|fiadd|ficom|ficomp|fidiv|fidivr|fild|fimul|fincstp|finit|fist|fistp|fisttp|fisub|fisubr|fld|fld1|fldcw|fldenv|fldenvd|fldenvw|fldl2e|fldl2t|fldlg2|fldln2|fldpi|fldz|fmul|fmulp|fnclex|fndisi|fneni|fninit|fnop|fnsave|fnsaved|fnsavew|fnstcw|fnstenv|fnstenvd|fnstenvw|fnstsw|fpatan|fprem|fprem1|fptan|frndint|frstor|frstord|frstorw|frstpm|fsave|fsaved|fsavew|fscale|fsetpm|fsin|fsincos|fsqrt|fst|fstcw|fstenv|fstenvd|fstenvw|fstp|fstsw|fsub|fsubp|fsubr|fsubrp|ftst|fucom|fucomi|fucomip|fucomp|fucompp|fwait|fxam|fxch|fxtract|fyl2x|fyl2xp1)(?![\\w.@$?])"
        },
        {
          "name": "keyword.other.mnemonic.mmx.fasm",
          "match": "(?i)(?<![\\w.@$?])(?:emms|femms|movd|movq|packssdw|packsswb|packuswb|paddb|paddd|paddsb|paddsw|paddusb|paddusw|paddw|pand|pandn|pavgusb|pcmpeqb|pcmpeqd|pcmpeqw|pcmpgtb|pcmpgtd|pcmpgtw|pf2id|pf2iw|pfacc|pfadd|pfcmpeq|pfcmpge|pfcmpgt|pfmax|pfmin|pfmul|pfnacc|pfpnacc|pfrcp|pfrcpit1|pfrcpit2|pfrsqit1|pfrsqrt|pfsub|pfsubr|pi2fd|pi2fw|pmaddwd|pmulhrw|pmulhw|pmullw|por|pslld|psllq|psllw|psrad|psraw|psrld|psrlq|psrlw|psubb|psubd|psubsb|psubsw|psubusb|psubusw|psubw|pswapd|punpckhbw|punpckhdq|punpckhwd|punpcklbw|punpckldq|punpcklwd|pxor)(?![\\w.@$?])"
        },
        {
          "name": "keyword.other.mnemonic.sse.fasm",
          "match": "(?i)(?<![\\w.@$?])(?:addpd|addps|addsd|addss|addsubpd|addsubps|andnpd|andnps|andpd|andps|blendpd|blendps|blendvpd|blendvps|clflush|cmpeqpd|cmpeqps|cmpeqsd|cmpeqss|cmplepd|cmpleps|cmplesd|cmpless|cmpltpd|cmpltps|cmpltsd|cmpltss|cmpneqpd|cmpneqps|cmpneqsd|cmpneqss|cmpnlepd|cmpnleps|cmpnlesd|cmpnless|cmpnltpd|cmpnltps|cmpnltsd|cmpnltss|cmpordpd|cmpordps|cmpordsd|cmpordss|cmppd|cmpps|cmpss|cmpunordpd|cmpunordps|cmpunordsd|cmpunordss|comisd|comiss|crc32|cvtdq2pd|cvtdq2ps|cvtpd2dq|cvtpd2pi|cvtpd2ps|cvtpi2pd|cvtpi2ps|cvtps2dq|cvtps2pd|cvtps2pi|cvtsd2si|cvtsd2ss|cvtsi2sd|cvtsi2ss|cvtss2sd|cvtss2si|cvttpd2dq|cvttpd2pi|cvttps2dq|cvttps2pi|cvttsd2si|cvttss2si|divpd|divps|divsd|divss|dppd|dpps|extractps|haddpd|haddps|hsubpd|hsubps|insertps|lddqu|ldmxcsr|lfence|maskmovdqu|maskmovq|maxpd|maxps|maxsd|maxss|mfence|minpd|minps|minsd|minss|movapd|movaps|movddup|movdq2q|movdqa|movdqu|movhlps|movhpd|movhps|movlhps|movlpd|movlps|movmskpd|movmskps|movntdq|movntdqa|movntpd|movntps|movntq|movq2dq|movshdup|movsldup|movss|movupd|movups|mpsadbw|mulpd|mulps|mulsd|mulss|orpd|orps|pabsb|pabsd|pabsw|packusdw|paddq|palignr|pavgb|pavgw|pblendvb|pblendw|pcmpeqq|pcmpestri|pcmpestrm|pcmpgtq|pcmpistri|pcmpistrm|pextrb|pextrd|pextrq|pextrw|phaddd|phaddsw|phaddw|phminposuw|phsubd|phsubsw|phsubw|pinsrb|pinsrd|pinsrq|pinsrw|pmaddubsw|pmaxsb|pmaxsd|pmaxsw|pmaxub|pmaxud|pmaxuw|pminsb|pminsd|pminsw|pminub|pminud|pminuw|pmovmskb|pmovsxbd|pmovsxbq|pmovsxbw|pmovsxdq|pmovsxwd|pmovsxwq|pmovzxbd|pmovzxbq|pmovzxbw|pmovzxdq|pmovzxwd|pmovzxwq|pmuldq|pmulhrsw|pmulhuw|pmulld|pmuludq|psadbw|pshufb|pshufd|pshufhw|pshuflw|pshufw|psignb|psignd|psignw|pslldq|psrldq|psubq|ptest|punpckhqdq|punpcklqdq|rcpps|rcpss|roundpd|roundps|roundsd|roundss|rsqrtps|rsqrtss|sfence|shufpd|shufps|sqrtpd|sqrtps|sqrtsd|sqrtss|stmxcsr|subpd|subps|subsd|subss|ucomisd|ucomiss|unpckhpd|unpckhps|unpcklpd|unpcklps|xorpd|xorps)(?![\\w.@$?])"
        },
