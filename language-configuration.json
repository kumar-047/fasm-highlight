{
    "comments": {
        "lineComment": ";",
        "blockComment": null
    },
    "brackets": [
        [
            "{",
            "}"
        ],
        [
            "[",
            "]"
        ],
        [
            "(",
            ")"
        ]
    ],
    "autoClosingPairs": [
        {
            "open": "{",
            "close": "}"
        },
        {
            "open": "[",
            "close": "]"
        },
        {
            "open": "(",
            "close": ")"
        },
        {
            "open": "'",
            "close": "'",
            "notIn": [
                "string",
                "comment"
            ]
        },
        {
            "open": "\"",
            "close": "\"",
            "notIn": [
                "string",
                "comment"
            ]
        }
    ],
    "surroundingPairs": [
        {
            "open": "{",
            "close": "}"
        },
        {
            "open": "[",
            "close": "]"
        },
        {
            "open": "(",
            "close": ")"
        },
        {
            "open": "'",
            "close": "'"
        },
        {
            "open": "\"",
            "close": "\""
        }
    ],
    "folding": {
        "markers": {
            "start": "^\\s*(?:[\\w.?$@]+:\\s*)?(?:(?:if|while|repeat|virtual|proc|struct|iterate|namespace|calminstruction|rawmatch|rmatch)\\b|data\\b(?!\\s*(?::|=|d[bwdqtpfu]\\b|r[bwdqtpf]\\b|equ\\b))|[^;]*\\{\\s*(?:;.*)?$)",
            "end": "^\\s*(?:end\\s+\\w+|endp\\b|ends\\b|\\})"
        }
    },
    "wordPattern": "(-?\\d*\\.\\d\\w*)|([^\\`\\~\\!\\@\\#\\%\\^\\&\\*\\(\\)\\-\\=\\+\\[\\{\\]\\}\\\\\\|\\;\\:\\'\\\"\\,\\.\\<\\>\\/\\?\\s]+)"
}