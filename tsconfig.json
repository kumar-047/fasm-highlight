{
    "compilerOptions": {
        "module": "commonjs",
        "moduleResolution": "bundler",
        "target": "ES2020",
        "lib": ["ES2020"],
        "types": ["node", "jest"],
        "rootDir": ".",
        "noEmit": true,
        "allowJs": true,
        "checkJs": false,
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true
    },
    "include": ["src", "test", "scripts", "jest.config.js", "eslint.config.mjs"]
}
