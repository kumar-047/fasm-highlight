{
  "name": "fasm-highlight",
  "displayName": "FASM Highlight",
  "description": "Syntax highlighting, hover cards, snippets, a control panel and build commands for flat assembler (fasm). Unofficial.",
  "version": "0.2.1",
  "publisher": "kumar-047",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "fasm",
    "assembly",
    "assembler",
    "x86",
    "x86-64",
    "asm",
    "flat assembler"
  ],
  "activationEvents": [
    "onLanguage:fasm"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "fasm",
        "aliases": [
          "FASM",
          "Flat Assembler",
          "fasm"
        ],
        "extensions": [
          ".asm",
          ".inc"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icon.png",
          "dark": "./icon.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "fasm",
        "scopeName": "source.fasm",
        "path": "./syntaxes/fasm.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "fasm.openPanel",
        "title": "Open Control Panel",
        "category": "FASM",
        "icon": "$(settings-gear)"
      },
      {
        "command": "fasm.build",
        "title": "Build",
        "category": "FASM"
      },
      {
        "command": "fasm.buildAndRun",
        "title": "Build and Run",
        "category": "FASM"
      },
      {
        "command": "fasm.stop",
        "title": "Stop Running Program",
        "category": "FASM"
      },
      {
        "command": "fasm.turnOnColors",
        "title": "Turn On FASM Colors",
        "category": "FASM"
      },
      {
        "command": "fasm.turnOffColors",
        "title": "Turn Off FASM Colors",
        "category": "FASM"
      },
      {
        "command": "fasm.insertStarter",
        "title": "Insert Starter Program",
        "category": "FASM"
      }
    ],
    "keybindings": [
      {
        "command": "fasm.build",
        "key": "ctrl+shift+b",
        "when": "editorLangId == fasm"
      },
      {
        "command": "fasm.buildAndRun",
        "key": "ctrl+shift+r",
        "when": "editorLangId == fasm"
      }
    ],
    "configuration": {
      "title": "FASM",
      "properties": {
        "fasm.compilerPath": {
          "type": "string",
          "default": "",
          "description": "Path to the fasm executable. Leave empty to use C:\\fasmw17335\\fasm.exe on Windows and fasm from PATH on other systems."
        },
        "fasm.memoryLimit": {
          "type": "number",
          "default": 65536,
          "description": "Memory limit in kilobytes passed to FASM with -m"
        },
        "fasm.passesLimit": {
          "type": "number",
          "default": 100,
          "description": "Maximum number of passes passed to FASM with -p"
        },
        "fasm.generateSymbols": {
          "type": "boolean",
          "default": false,
          "description": "Generate symbolic information for debugging with the -s flag"
        },
        "fasm.fasm2Path": {
          "type": "string",
          "default": "",
          "description": "Path to fasm2.cmd or fasm2. Leave empty to search for it."
        },
        "fasm.fasmgPath": {
          "type": "string",
          "default": "",
          "description": "Path to the fasmg executable. Leave empty to search for it."
        },
        "fasm.fasmarmPath": {
          "type": "string",
          "default": "",
          "description": "Path to the FASMARM executable. Leave empty to search for it."
        },
        "fasm.assembler": {
          "type": "string",
          "enum": [
            "auto",
            "fasm",
            "fasm2",
            "fasmg",
            "fasmarm"
          ],
          "default": "auto",
          "description": "Which compiler builds FASM files. Automatic picks one from the file."
        },
        "fasm.architecture": {
          "type": "string",
          "enum": [
            "auto",
            "x86",
            "8051",
            "avr",
            "jvm",
            "wasm",
            "aarch64",
            "arm"
          ],
          "default": "auto",
          "description": "The architecture of FASM files. Automatic reads the file's include lines."
        },
        "fasm.targetSystem": {
          "type": "string",
          "enum": [
            "auto",
            "windows",
            "linux",
            "macos"
          ],
          "default": "auto",
          "description": "The system to suggest snippets for. A format line in the file always wins."
        },
        "fasm.panelSide": {
          "type": "string",
          "enum": [
            "right",
            "left"
          ],
          "default": "right",
          "description": "Which side the FASM panel opens on. Editors without a right-side area use the left."
        },
        "fasm.format.commentColumn": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "The column to align trailing comments to when formatting. 0 keeps your spacing."
        },
        "fasm.colors.overrides": {
          "type": "object",
          "default": {},
          "description": "Custom FASM Colors, by role. The Settings tab of the FASM panel edits this."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "fasmPanelLeft",
          "title": "FASM",
          "icon": "media/panel-icon.svg"
        }
      ],
      "secondarySidebar": [
        {
          "id": "fasmPanelRight",
          "title": "FASM",
          "icon": "media/panel-icon.svg"
        }
      ]
    },
    "views": {
      "fasmPanelLeft": [
        {
          "type": "webview",
          "id": "fasm.panelLeft",
          "name": "FASM",
          "when": "fasm.panelReady && !fasm.panelOnRight"
        }
      ],
      "fasmPanelRight": [
        {
          "type": "webview",
          "id": "fasm.panelRight",
          "name": "FASM",
          "when": "fasm.panelReady && fasm.panelOnRight"
        }
      ]
    },
    "menus": {
      "editor/title": [
        {
          "command": "fasm.openPanel",
          "when": "editorLangId == fasm",
          "group": "navigation"
        }
      ]
    },
    "configurationDefaults": {
      "[fasm]": {
        "editor.semanticHighlighting.enabled": true
      }
    },
    "semanticTokenScopes": [
      {
        "language": "fasm",
        "scopes": {
          "keyword": [
            "keyword.other.mnemonic.arch.fasm"
          ],
          "variable": [
            "variable.language.register.arch.fasm"
          ],
          "macro": [
            "keyword.control.directive.fasmg.fasm"
          ]
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p tsconfig.build.json && node scripts/generate-grammar.js",
    "watch": "tsc -watch -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src test scripts",
    "test": "jest",
    "check": "npm run typecheck && npm run lint && npm test",
    "package": "vsce package",
    "publish:openvsx": "npx ovsx publish"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/vscode": "^1.75.0",
    "@vscode/vsce": "^4.1.0",
    "eslint": "^10.14.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.1",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kumar-047/fasm-highlight"
  },
  "license": "MIT",
  "homepage": "https://github.com/kumar-047/fasm-highlight#readme",
  "bugs": {
    "url": "https://github.com/kumar-047/fasm-highlight/issues"
  }
}
