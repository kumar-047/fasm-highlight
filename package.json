{
  "name": "fasm-highlight",
  "displayName": "FASM Highlight",
  "description": "Syntax highlighting, hover cards, snippets and build commands for flat assembler (fasm). Unofficial.",
  "version": "0.2.1",
  "publisher": "kumar-047",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Themes"
  ],
  "keywords": [
    "fasm",
    "assembly",
    "assembler",
    "x86",
    "x86-64",
    "asm",
    "flat assembler"
  ],
  "activationEvents": [
    "onLanguage:fasm"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "fasm",
        "aliases": [
          "FASM",
          "Flat Assembler",
          "fasm"
        ],
        "extensions": [
          ".asm",
          ".inc"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icon.png",
          "dark": "./icon.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "fasm",
        "scopeName": "source.fasm",
        "path": "./syntaxes/fasm.tmLanguage.json"
      }
    ],
    "themes": [
      {
        "label": "FASM Colors",
        "uiTheme": "vs-dark",
        "path": "./themes/fasm-colors-color-theme.json"
      }
    ],
    "snippets": [
      {
        "language": "fasm",
        "path": "./snippets/fasm.json"
      }
    ],
    "commands": [
      {
        "command": "fasm.build",
        "title": "Build",
        "category": "FASM"
      },
      {
        "command": "fasm.buildAndRun",
        "title": "Build and Run",
        "category": "FASM"
      }
    ],
    "keybindings": [
      {
        "command": "fasm.build",
        "key": "ctrl+shift+b",
        "when": "editorLangId == fasm"
      },
      {
        "command": "fasm.buildAndRun",
        "key": "ctrl+shift+r",
        "when": "editorLangId == fasm"
      }
    ],
    "configuration": {
      "title": "FASM",
      "properties": {
        "fasm.compilerPath": {
          "type": "string",
          "default": "",
          "description": "Path to the fasm executable. Leave empty to use C:\\fasmw17335\\fasm.exe on Windows and fasm from PATH on other systems."
        },
        "fasm.memoryLimit": {
          "type": "number",
          "default": 65536,
          "description": "Memory limit in kilobytes passed to FASM with -m"
        },
        "fasm.passesLimit": {
          "type": "number",
          "default": 100,
          "description": "Maximum number of passes passed to FASM with -p"
        },
        "fasm.generateSymbols": {
          "type": "boolean",
          "default": false,
          "description": "Generate symbolic information for debugging with the -s flag"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./ && node scripts/generate-grammar.js",
    "watch": "tsc -watch -p ./",
    "typecheck": "tsc -p ./ --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint src test scripts",
    "test": "jest",
    "check": "npm run typecheck && npm run lint && npm test",
    "package": "vsce package",
    "publish:openvsx": "npx ovsx publish"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/jest": "^29.5.14",
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.75.0",
    "@vscode/vsce": "^2.22.0",
    "eslint": "^9.39.5",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.15",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.72.1",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kumar-047/fasm-highlight"
  },
  "license": "MIT",
  "homepage": "https://github.com/kumar-047/fasm-highlight#readme",
  "bugs": {
    "url": "https://github.com/kumar-047/fasm-highlight/issues"
  }
}
