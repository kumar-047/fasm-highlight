{
  "name": "fasm-highlight",
  "displayName": "FASM Highlight",
  "description": "Highlights your fasm code, with hover cards, simple snippets, light formatting, and font and color styling. Works with fasm, fasm 2 and fasmg on Windows, Linux and macOS.",
  "version": "0.2.2",
  "publisher": "kumar-047",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Formatters"
  ],
  "keywords": [
    "fasm",
    "assembly",
    "assembler",
    "x86",
    "x86-64",
    "asm",
    "flat assembler"
  ],
  "activationEvents": [
    "onLanguage:fasm"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "fasm",
        "aliases": [
          "FASM",
          "Flat Assembler",
          "fasm"
        ],
        "extensions": [
          ".asm",
          ".inc"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icon.png",
          "dark": "./icon.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "fasm",
        "scopeName": "source.fasm",
        "path": "./syntaxes/fasm.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "fasm.build",
        "title": "Build",
        "category": "FASM"
      },
      {
        "command": "fasm.formatFile",
        "title": "Format File",
        "category": "FASM"
      },
      {
        "command": "fasm.openMenu",
        "title": "FASM Menu",
        "category": "FASM"
      }
    ],
    "keybindings": [
      {
        "command": "fasm.build",
        "key": "ctrl+shift+b",
        "when": "editorLangId == fasm"
      }
    ],
    "configuration": {
      "title": "FASM",
      "properties": {
        "fasm.compilerPath": {
          "type": "string",
          "default": "",
          "description": "Path to your fasm, fasm 2 or fasmg compiler, used by FASM: Build. Leave empty to use C:\\fasmw17335\\fasm.exe on Windows and fasm from PATH on other systems."
        },
        "fasm.memoryLimit": {
          "type": "number",
          "default": 65536,
          "description": "Memory limit in kilobytes passed to FASM with -m"
        },
        "fasm.passesLimit": {
          "type": "number",
          "default": 100,
          "description": "Maximum number of passes passed to FASM with -p"
        },
        "fasm.generateSymbols": {
          "type": "boolean",
          "default": false,
          "description": "Generate symbolic information for debugging with the -s flag"
        },
        "fasm.targetSystem": {
          "type": "string",
          "enum": [
            "auto",
            "windows",
            "linux",
            "macos"
          ],
          "default": "auto",
          "description": "The system to suggest snippets for. A format line in the file always wins."
        },
        "fasm.format.commentColumn": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "The column to align trailing comments to when formatting. 0 keeps your spacing."
        },
        "fasm.colors.overrides": {
          "type": "object",
          "default": {},
          "description": "Custom FASM Colors, by role. The Settings tab of the FASM panel edits this."
        },
        "fasm.format.operandColumn": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "The column to align instruction operands to when formatting. 0 uses one space."
        },
        "fasm.format.spaceAfterComma": {
          "type": "boolean",
          "default": false,
          "description": "Add a space after commas when formatting. Text inside strings is never changed."
        },
        "fasm.format.maxBlankLines": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "The most blank lines to keep in a row when formatting. 0 keeps them all."
        },
        "fasm.colors.palette": {
          "type": "string",
          "enum": [
            "auto",
            "fasm-dark",
            "ember",
            "ocean",
            "forest",
            "mono",
            "fasm-light",
            "paper",
            "sky"
          ],
          "default": "auto",
          "description": "The FASM Colors palette. Automatic picks FASM Dark or FASM Light to match your theme."
        }
      }
    },
    "configurationDefaults": {
      "[fasm]": {
        "editor.semanticHighlighting.enabled": true
      }
    },
    "semanticTokenScopes": [
      {
        "language": "fasm",
        "scopes": {
          "keyword": [
            "keyword.other.mnemonic.arch.fasm"
          ],
          "variable": [
            "variable.language.register.arch.fasm"
          ],
          "operator": [
            "keyword.operator.word.fasm"
          ],
          "function": [
            "entity.name.function.fasm"
          ]
        }
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "fasm.openMenu",
          "when": "editorLangId == fasm",
          "group": "1_modification@9"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p tsconfig.build.json && node scripts/generate-grammar.js",
    "watch": "tsc -watch -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src test scripts",
    "test": "jest",
    "check": "npm run typecheck && npm run lint && npm test",
    "package": "vsce package",
    "publish:openvsx": "node scripts/publish-openvsx.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/vscode": "^1.75.0",
    "@vscode/vsce": "^4.1.0",
    "eslint": "^10.14.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.1",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kumar-047/fasm-highlight"
  },
  "license": "MIT",
  "homepage": "https://github.com/kumar-047/fasm-highlight#readme",
  "bugs": {
    "url": "https://github.com/kumar-047/fasm-highlight/issues"
  }
}
